# Production environment variables for Vercel deployment
# Set these in Vercel Dashboard → Project → Environment Variables
# OR use: vercel env add VITE_API_BASE_URL production

# Backend API URL (replace with your Render backend URL after deployment)
# Example: https://mausam-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://mausam-backend-3gga.onrender.com/api/v1
